# Copia a .env y ajusta. Ninguna ruta absoluta de usuario en el repo (norma sin-rutas-absolutas).
# Prefijo MHLS_ para todas las variables de la app (D36). Precedencia: defaults < /config/config.yaml < entorno.

# Ruta del archivo a vigilar en el host (se monta en /archive dentro del contenedor)
MHLS_ARCHIVE_HOST_PATH=/path/to/ARCHIVE
# Carpeta local (disco local, NUNCA un share SMB/NFS) para config.yaml y state.db
MHLS_CONFIG_HOST_PATH=./config
# Zona horaria del horario laboral (D33). El contenedor corre siempre con TZ=UTC.
MHLS_TIMEZONE=Europe/Madrid
# Usuario/grupo/umask con el que escribe el contenedor (convención PUID/PGID/UMASK de NAS, D69).
# PGID 100 = everyone en QNAP; UMASK 000 = lo que la app crea en el archivo queda 777/666 y el equipo
# puede borrarlo por SMB (el acceso lo controlan los permisos de share de QTS, no los bits POSIX).
PUID=1000
PGID=100
UMASK=000
# Puerto de la GUI
MHLS_PORT=8080
# Tema de la GUI (D56): auto (sigue al sistema), light o dark. Mejor desde Ajustes; si se fija
# aquí, gana sobre lo que se guarde en la GUI tras reiniciar.
# MHLS_THEME=auto
